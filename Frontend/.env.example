# FLOODGUARD AI — Frontend Environment Variables
# Copy anything you need into .env.local (gitignored) to override the defaults.
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser.
#
# Defaults are set by the mode files, so no copy is required:
#   next dev  -> .env.development -> http://localhost:8000
#   next build-> .env.production   -> the deployed Azure backend
#
# Backend base URL (host only, no /api suffix — the client appends it).
# Local development against a backend on this machine:
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Production (deployed backend — this is what .env.production sets):
NEXT_PUBLIC_API_BASE=https://floodguard-backend.ashyplant-04472250.centralindia.azurecontainerapps.io
