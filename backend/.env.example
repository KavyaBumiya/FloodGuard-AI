# FLOODGUARD AI — Backend Environment Variables
# Copy this to .env and fill in your values

# Database
# This password matches docker-compose.yml, backend/alembic.ini and the
# Settings default, so `docker compose up -d` then `alembic upgrade head`
# works on a fresh clone with no edits.
# NOTE: if your `pgdata` volume predates this, it keeps its ORIGINAL password.
# Either use the volume's password here, or recreate it with `docker compose
# down -v` (destructive).
DATABASE_URL=postgresql+asyncpg://floodguard:floodguard@localhost:5432/floodguard

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# IoT Device Registration (bootstrap secret)
IOT_REGISTRATION_TOKEN=your-registration-token-here

# Telemetry ingress
# HTTP only — the ESP32 POSTs to /api/iot/telemetry over HTTPS with its bearer
# token. There is no broker and nothing to host.

# OpenTopography (for SRTM DEM download)
# Register a free key at https://portal.opentopography.org/
# NEVER commit a real key. Keep it only in backend/.env
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_BASE_URL=https://portal.opentopography.org/API/globaldem

# Cesium Ion (for 3D terrain/buildings)
# Set this only if you need Cesium World Terrain / OSM Buildings.
# Leave blank to use the bundled offline SRTM terrain + OSM building extrusion.
CESIUM_ION_TOKEN=

# Open-Meteo (no key required for basic use)
OPEN_METEO_API_BASE=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_BASE=https://archive-api.open-meteo.com/v1/era5

# Overpass API (OSM data)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Nominatim (geocoding)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FLOODGUARD-AI/1.0

# ML Model paths
FLOOD_MODEL_DIR=models/flood
FLOOD_MODEL_15MIN=rf_15min.joblib
FLOOD_MODEL_30MIN=rf_30min.joblib
FLOOD_MODEL_60MIN=rf_60min.joblib

# Demo settings
DEMO_MODE_ENABLED=true
DEMO_REPLAY_SPEED=1.0
DEMO_RESET_ON_STARTUP=false

# Vadodara real demo input -> simulated Mithi calibration.
# This is a configurable demonstration mapping, not a hydraulic relationship.
DEMO_INPUT_NODE_CODE=
DEMO_INPUT_PHYSICAL_MIN_CM=0
DEMO_INPUT_PHYSICAL_MAX_CM=30
DEMO_INPUT_MITHI_MIN_CM=118
DEMO_INPUT_MITHI_MAX_CM=220
DEMO_INPUT_MITHI_RAINFALL_FACTOR=0.8

# ─────────────────────────────────────────────────────────────────────────────
# Managed deployment (Render / Heroku / Neon / Supabase)
# See docs/16-DEPLOYMENT.md. All optional locally.
# ─────────────────────────────────────────────────────────────────────────────

# Render injects DATABASE_URL as `postgresql://…`. Do NOT edit it by hand —
# Settings._force_asyncpg rewrites the scheme to `postgresql+asyncpg://` and
# Settings.database_dsn appends `?ssl=require` for any non-loopback host, so
# the engine, Alembic and the scripts all read one consistent DSN.
# Override the TLS decision only if your provider rejects it:
# DATABASE_REQUIRE_SSL=false

# Lets python-socketio fan emits out across uvicorn workers via Redis. Turn off
# only if Redis is unreachable; otherwise a client on worker B silently misses
# every event published on worker A.
# SOCKETIO_MESSAGE_QUEUE=true

# Release command (scripts/release.py). RELEASE_LOAD_OSM=true inserts the ~8,900
# OSM rows — needed once per database, wasted on every later deploy.
# RELEASE_DB_WAIT_ATTEMPTS=30
# RELEASE_LOAD_OSM=false

# App
APP_ENV=development
MEDIA_DIR=media/audio

# Frontend origin (for CORS)
# Comma-separated. Empty = allow all, which is only safe locally.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN_REGEX=