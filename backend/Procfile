# FLOODGUARD AI — Render / Heroku process declaration
#
# Only used if you deploy as a NATIVE Python service rather than a Docker one
# (Render -> New -> Web Service -> Runtime: Python). render.yaml sets
# `runtime: docker`, which uses backend/Dockerfile and ignores this file.
#
#   web: uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1
#
# Single worker on purpose — see the CMD comment in backend/Dockerfile for why
# (the forecast and alert engines are per-process and not idempotent).
#
# Run migrations BEFORE the first boot, not on every deploy, when using the
# native runtime (Render's native services have no releaseCommand):
#
#   python -m scripts.release
web: uvicorn app.main:app --host 0.0.0.0 --port $PORT --workers 1 --proxy-headers --forwarded-allow-ips='*'