# Large data files (handled separately)
# dem_mithi.tif is required by the flood simulation at runtime — must be in the image
!data/terrain/dem_mithi.tif
data/terrain/_*.tif
data/IMD/
data/rainfall/

# Test outputs
backend/tests/__pycache__
backend/.pytest_cache

# Documentation
docs/*.pdf
*.md
!README.md

# Infrastructure (not needed in build context)
infra/
*.bicep
*.sh

# Deployment configs (not needed in image)
.github/
docker-compose.yml
AZURE_DEPLOYMENT.md

# Media (empty directory created in Dockerfile)
media/

# Frontend source (not needed for backend)
Frontend/